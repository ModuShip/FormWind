{
  "$schema": "http://json.schemastore.org/template",
  "author": "İsmail Yücel Ölmez",
  "classifications": [ "Desktop", "WinForms", "FormWind" ],
  "identity": "FormWind.App.CSharp",
  "name": "FormWind WinForms App",
  "description": "A WinForms app styled with FormWind classes: sign-in, list-detail and settings screens, light and dark theme.",
  "shortName": "formwind-app",
  "sourceName": "FormWindApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        { "condition": "(Framework != \"net472\")", "exclude": [ "app.manifest" ] }
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "Target framework.",
      "datatype": "choice",
      "choices": [
        { "choice": "net8.0-windows", "description": ".NET 8" },
        { "choice": "net9.0-windows", "description": ".NET 9" },
        { "choice": "net10.0-windows", "description": ".NET 10" },
        { "choice": "net472", "description": ".NET Framework 4.7.2" }
      ],
      "defaultValue": "net8.0-windows",
      "replaces": "TARGET_FRAMEWORK"
    },
    "Palette": {
      "type": "parameter",
      "description": "Tailwind color palette.",
      "datatype": "choice",
      "choices": [
        { "choice": "v3", "description": "Tailwind CSS v3" },
        { "choice": "v4", "description": "Tailwind CSS v4 (OKLCH)" }
      ],
      "defaultValue": "v3",
      "replaces": "PALETTE_VERSION"
    },
    "Preset": {
      "type": "parameter",
      "description": "Ready-made look.",
      "datatype": "choice",
      "choices": [
        { "choice": "tailwind", "description": "Tailwind CSS colors and components" },
        { "choice": "fluent", "description": "Inspired by Fluent 2 (Windows 11)" },
        { "choice": "antd", "description": "Inspired by Ant Design" },
        { "choice": "material", "description": "Inspired by Material Design 3" }
      ],
      "defaultValue": "tailwind",
      "replaces": "PRESET_NAME"
    },
    "Krypton": {
      "type": "parameter",
      "description": "Adds FormWind.Krypton: classes on Krypton Toolkit controls and a Krypton palette that follows the theme.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "FormWindVersion": {
      "type": "parameter",
      "description": "FormWind package version.",
      "datatype": "text",
      "defaultValue": "0.1.0",
      "replaces": "FORMWIND_VERSION"
    }
  }
}
