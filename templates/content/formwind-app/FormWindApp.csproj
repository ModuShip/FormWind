<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
<!--#if (Framework == "net472") -->
    <!-- .NET Framework: per-monitor DPI comes from the manifest (on .NET, Program calls Application.SetHighDpiMode). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FormWind" Version="FORMWIND_VERSION" />
<!--#if (Krypton) -->
    <!-- Krypton Toolkit controls: classes (KryptonApplier) and a palette that follows the theme (TwKryptonTheme). -->
    <PackageReference Include="FormWind.Krypton" Version="FORMWIND_VERSION" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <None Update="tw.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
