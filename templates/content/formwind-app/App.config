<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Per-monitor DPI for WinForms on .NET Framework. The manifest makes the process DPI-aware; this key turns on WinForms'
    own per-monitor support (rescaling forms on WM_DPICHANGED when a window moves to a screen with another scale).
    Do not add a <configSections> entry for this section: machine.config already declares it, and declaring it again
    makes the configuration system fail to start (ConfigurationManager throws on first use).
    The build adds the binding redirects FormWind needs to the output .exe.config; this file does not list them.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
