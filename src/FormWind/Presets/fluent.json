{
  // FormWind preset inspired by Fluent 2 (Windows 11). Copy this file into tw.config.json to customize it.
  // Components not listed here are the defaults (TwTheme.DefaultComponents) drawn with the colors below.
  "version": 1,
  "fontFamily": "Segoe UI Variable Text, Segoe UI",
  "fontWeights": {
    "Segoe UI Variable Text": { "300": "Segoe UI Variable Text Light", "350": "Segoe UI Variable Text Semiligh", "600": "Segoe UI Variable Text Semibold" }
  },
  "colors": {
    // Communication blue (brand ramp); 600 = #0f6cbd.
    "primary": {
      "50": "#ebf3fc", "100": "#cfe4fa", "200": "#b4d6fa", "300": "#96c6fa", "400": "#479ef5", "500": "#2886de",
      "600": "#0f6cbd", "700": "#115ea3", "800": "#0f548c", "900": "#0c3b5e", "950": "#061724"
    },
    // Neutral grays: backgrounds #fafafa/#f5f5f5, strokes #e0e0e0/#d1d1d1, foregrounds #616161/#424242/#242424.
    "surface": {
      "50": "#fafafa", "100": "#f5f5f5", "200": "#e0e0e0", "300": "#d1d1d1", "400": "#adadad", "500": "#707070",
      "600": "#616161", "700": "#424242", "800": "#292929", "900": "#1f1f1f", "950": "#141414"
    }
  },
  "components": {
    "btn": "px-3 py-1.5 rounded text-sm font-semibold cursor-pointer transition",
    "btn-primary": "btn bg-primary-600 text-white hover:bg-primary-700 active:bg-primary-800 disabled:bg-surface-200 disabled:text-surface-500 dark:bg-primary-600 dark:hover:bg-primary-700 dark:active:bg-primary-800 dark:disabled:bg-surface-800 dark:disabled:text-surface-400",
    "btn-secondary": "btn bg-surface-100 text-surface-900 hover:bg-surface-200 active:bg-surface-300 disabled:bg-surface-100 disabled:text-surface-500 dark:bg-surface-700 dark:text-surface-100 dark:hover:bg-surface-600 dark:active:bg-surface-600 dark:disabled:bg-surface-800 dark:disabled:text-surface-400",
    "btn-ghost": "btn bg-white text-surface-900 border border-surface-300 hover:bg-surface-100 active:bg-surface-200 disabled:bg-surface-100 disabled:text-surface-500 disabled:border-surface-200 dark:bg-surface-800 dark:text-surface-100 dark:border-surface-600 dark:hover:bg-surface-700 dark:active:bg-surface-700 dark:disabled:bg-surface-800 dark:disabled:text-surface-400 dark:disabled:border-surface-700",
    "btn-danger": "btn bg-danger-700 text-white hover:bg-danger-800 active:bg-danger-900 disabled:bg-surface-200 disabled:text-surface-500 dark:disabled:bg-surface-800 dark:disabled:text-surface-400",
    "input": "bg-white text-surface-900 border border-surface-300 rounded px-3 py-1.5 placeholder:text-surface-500 hover:border-surface-400 focus:border-primary-600 invalid:border-danger-600 dark:bg-surface-800 dark:text-surface-100 dark:border-surface-600 dark:placeholder:text-surface-400 dark:focus:border-primary-400 dark:invalid:border-danger-400",
    "page": "font-sans bg-surface-100 text-surface-900 dark:bg-surface-900 dark:text-surface-100",
    "card": "bg-white border border-surface-200 rounded-lg p-4 shadow dark:bg-surface-800 dark:border-surface-700",
    "nav-item": "px-3 py-2 rounded text-sm text-left cursor-pointer bg-white text-surface-900 hover:bg-surface-100 checked:bg-surface-200 checked:font-semibold dark:bg-surface-800 dark:text-surface-100 dark:hover:bg-surface-700 dark:checked:bg-surface-700",
    "title": "text-2xl font-semibold text-surface-900 dark:text-white",
    "muted": "text-sm text-surface-600 dark:text-surface-400",
    "badge": "text-xs font-semibold rounded px-2 text-center bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-100",
    "alert-info": "p-3 rounded border text-sm bg-primary-50 border-primary-200 text-primary-800 dark:bg-primary-950 dark:border-primary-800 dark:text-primary-100",
    "alert-success": "p-3 rounded border text-sm bg-success-50 border-success-200 text-success-800 dark:bg-success-950 dark:border-success-800 dark:text-success-100",
    "alert-warning": "p-3 rounded border text-sm bg-warning-50 border-warning-200 text-warning-800 dark:bg-warning-950 dark:border-warning-800 dark:text-warning-100",
    "alert-danger": "p-3 rounded border text-sm bg-danger-50 border-danger-200 text-danger-800 dark:bg-danger-950 dark:border-danger-800 dark:text-danger-100",
    "table": "bg-white text-sm text-surface-900 border border-surface-200 divide-y divide-surface-200 header:bg-white header:text-surface-600 header:font-semibold header:h-9 header:px-3 header:whitespace-nowrap cell:px-3 row:h-10 row:hover:bg-surface-100 selected:bg-surface-200 selected:text-surface-900 row-header:hidden dark:bg-surface-800 dark:text-surface-100 dark:border-surface-700 dark:divide-surface-700 dark:header:bg-surface-800 dark:header:text-surface-400 dark:row:hover:bg-surface-700 dark:selected:bg-surface-700 dark:selected:text-white group:bg-surface-50 group:text-surface-900 group:font-semibold footer:bg-surface-50 footer:text-surface-900 footer:font-semibold match:bg-warning-200 dark:group:bg-surface-900 dark:group:text-surface-100 dark:footer:bg-surface-900 dark:footer:text-surface-100 dark:match:bg-warning-800 dark:match:text-white",
    "table-sm": "text-xs header:h-8 header:px-2 cell:px-2 row:h-8",
    "table-lg": "header:h-11 header:px-3 cell:px-3 row:h-11",
    "tabs": "text-surface-600 border-b border-surface-200 selected:text-surface-900 selected:border-primary-600 item:hover:text-surface-900 dark:text-surface-400 dark:border-surface-700 dark:selected:text-white dark:selected:border-primary-400 dark:item:hover:text-white"
  }
}
